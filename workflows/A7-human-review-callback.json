      "parameters": {
        "jsCode": "const webhookData = $('Webhook').first().json.query;\nconst tokenDoc = $input.first().json;\n\nconst receivedToken = webhookData.token;\nconst validToken = receivedToken === tokenDoc.token_approve || \n                   receivedToken === tokenDoc.token_reject;\nconst notUsed = tokenDoc.used === false || tokenDoc.used === 'false';\n\nreturn {\n  ...tokenDoc,\n  token_valid: validToken && notUsed,\n  received_token: receivedToken,\n  action: webhookData.action,\n  story_id: webhookData.story_id\n};"
      },
