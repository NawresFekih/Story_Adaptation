    {
      "parameters": {
        "jsCode": "const firestoreData = $input.item.json;\nconst webhookData = $('Edit Fields').item.json;\n\nconst MAX_REJECTIONS = 3;\n\nconst sectionsStatus = firestoreData.sections_status || {};\nconst section = webhookData.section;\n\nconst prevCount = sectionsStatus[section]?.rejection_count || 0;\nconst newCount = prevCount + 1;\n\nconst escalated = newCount >= MAX_REJECTIONS;\n\nsectionsStatus[section] = {\n  status: escalated ? 'needs_manual_review' : 'rejected',\n  rejection_count: newCount\n};\n\nreturn {\n  story_id: webhookData.story_id,\n  section,\n  rejection_count: newCount,\n  escalated,\n  sections_status: sectionsStatus,\n  status: escalated ? 'illustration_blocked' : 'illustrations_in_progress'\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        688,
        256
      ],
      "id": "e249adb4-cbd5-4a8f-879c-d1f91118f30f",
      "name": "Update Section Status — Reject"
    }
