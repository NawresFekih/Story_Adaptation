    {
      "parameters": {
        "jsCode": "const firestoreData = $input.item.json;\nconst webhookData = $('Edit Fields3').item.json;\n\nconst sectionsStatus = firestoreData.sections_status || {};\nconst sectionKeys = firestoreData.section_keys || Object.keys(sectionsStatus);\nconst section = webhookData.section;\n\nsectionsStatus[section] = {\n  status: 'approved',\n  file_id: webhookData.file_id,\n  drive_link: webhookData.drive_link\n};\n\nconst allApproved = sectionKeys.length > 0 &&\n  sectionKeys.every(k => sectionsStatus[k]?.status === 'approved');\n\nreturn {\n  story_id: webhookData.story_id,\n  sections_status: sectionsStatus,\n  status: allApproved ? 'illustrations_complete' : 'illustration_in_progress'\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        640,
        -144
      ],
      "id": "f92f2a2c-3ed5-4519-a2e4-0c9418b56b88",
